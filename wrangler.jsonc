{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hangtime",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [
      { "name": "MOOSE_DO", "class_name": "HangtimeDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["HangtimeDO"] }
  ],
  "vars": {
    "TARGET_DEGREE_DAYS": 40,
    "MAX_GAP_MINUTES": 240
  }
  // Secrets (set with `wrangler secret put <NAME>`, not stored here):
  //   APP_PASSWORD  — shared login password for the UI
  //   GATEWAY_TOKEN — shared secret the Shelly gateway presents on the /ws upgrade
}
